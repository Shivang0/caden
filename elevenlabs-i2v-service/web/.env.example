# The job queue runs on MongoDB Atlas; video output is stored in Vercel Blob.
#   BLOB_READ_WRITE_TOKEN=...   (injected automatically by the linked Blob store)
# Set these yourself (Project → Settings → Environment Variables):
MONGODB_URI=
MONGODB_DB=i2v
WORKER_SECRET=change-me-long-random-string
VISITOR_SALT=some-random-salt
# Optional tuning (defaults shown):
GLOBAL_DAILY_CAP=40
PER_VISITOR_HOURLY=3
MAX_QUEUE=15
