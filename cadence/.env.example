# Vercel AI Gateway key — powers the multi-agent content pipeline.
# Without it the app runs in MOCK mode (deterministic artifacts from real GitHub data).
AI_GATEWAY_API_KEY=

# Model in provider/model form (all routes share this id)
CADENCE_MODEL=anthropic/claude-sonnet-5

# Direct Anthropic route (used when no AI Gateway key is present)
ANTHROPIC_API_KEY=

# Last-resort LLM route (same model id namespace)
OPENROUTER_API_KEY=

# Optional: raises GitHub API rate limits (public repos work without it)
GITHUB_TOKEN=

# ElevenLabs — voiceover generation for the audio/video update
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Aqua Voice — founder voice dictation (speech-to-text)
AQUA_API_KEY=

# --- Database (MongoDB: users, sessions-by-id, per-user connections) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cadence

# --- Auth (email/password) ---
# Random 32+ char string for signing session JWTs + encrypting connection
# tokens at rest (openssl rand -hex 32). REQUIRED in production.
AUTH_SECRET=
# e.g. http://localhost:3000 in dev, the deployed URL in prod
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Billing (Stripe) — only PAID users can connect accounts ---
# Set BOTH to actually charge; if unset, connecting is open to any logged-in
# user (dev convenience) and no paywall is enforced.
STRIPE_SECRET_KEY=
# Price id of the subscription (create in Stripe; price it in your account currency)
STRIPE_PRICE_ID=
# Promo code that unlocks the free trial (validated in-app, not a Stripe coupon)
PROMO_CODE=SWEYOUNG26
PROMO_TRIAL_DAYS=7

# --- One-click Connect (OAuth apps you create; see CONNECT-SETUP.md) ---
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Linkup — press & web mentions in every update (server key, no user setup)
LINKUP_API_KEY=
