# demo-web (static landing + live demo). Copy to .env.local and fill in.
# The live demo streams from the multi-agent pipeline in api/generate.js.

# NVIDIA integrate.api.nvidia.com key (OpenAI-compatible chat/completions)
NVIDIA_API_KEY=

# GitHub token (raises the API rate limit; unlocks private/org repo reads)
GITHUB_TOKEN=

# Linkup search key (founder voice profiling + photo search)
LINKUP_API_KEY=

# ElevenLabs — TTS, voice cloning, and the i2v voiceover mux
# Either key name works; ELEVEN_KEY_V2 takes precedence if both are set.
ELEVENLABS_API_KEY=
ELEVEN_KEY_V2=
